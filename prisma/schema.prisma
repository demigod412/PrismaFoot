// PitchEdge — Prisma schema (Phase 0–3 ready)
// Rules encoded here:
//  * Predictions are append-only. A lineup revision inserts a new row (revision + 1).
//  * A locked prediction (lockedAt != null) is never updated by application code.
//  * Results are append-only; a correction inserts a new Result row with supersedesId.

generator client {
  provider        = "prisma-client-js"
  // `omit` lets a list query drop the four heavy Json columns (matrix, topScorelines, rationale,
  // features) without hand-listing every other field — so a column added later is included by default
  // rather than silently missing from every page.
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  DEMO
  FOOTBALL_DATA
  API_FOOTBALL
  SPORTMONKS
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum ConfidenceBand {
  HIGH
  MEDIUM
  LOW
}

model League {
  id         String    @id @default(cuid())
  provider   Provider
  externalId String
  name       String
  country    String
  code       String?
  season     Int
  tier       Int       @default(1)
  focusGroup String? // "europe-strong" | "england" | "international" | null
  ratingPool String? // leagues sharing a pool are rated together by team externalId (national teams: "intl", European cups: "europe")
  feedsPool  String? // domestic league whose matches also feed a pool (e.g. Premier League → "europe"), but is predicted with its own fit
  neutral    Boolean   @default(false) // tournament finals: most games at neutral venues → no home advantage
  // Per-league model parameters (refit on every rating run)
  homeAdv    Float     @default(1.25) // γ_league
  rho        Float     @default(-0.08) // Dixon–Coles ρ
  baseGoals  Float     @default(1.35) // mean away goals, neutral scale
  volatility Float     @default(0.5) // 0..1, from residual variance of goal totals
  lastSyncAt DateTime?
  historyAt  DateTime? // last time finished previous seasons were re-read (they never change)
  teams      Team[]
  fixtures   Fixture[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([provider, externalId, season])
  @@index([focusGroup])
}

model Team {
  id           String               @id @default(cuid())
  provider     Provider
  externalId   String
  name         String
  shortName    String?
  crestUrl     String?
  leagueId     String
  league       League               @relation(fields: [leagueId], references: [id])
  homeFixtures Fixture[]            @relation("home")
  awayFixtures Fixture[]            @relation("away")
  ratings      TeamRatingSnapshot[]

  @@unique([provider, externalId, leagueId])
}

model Fixture {
  id            String        @id @default(cuid())
  provider      Provider
  externalId    String
  leagueId      String
  league        League        @relation(fields: [leagueId], references: [id])
  season        Int
  round         String?
  kickoffUtc    DateTime
  status        FixtureStatus @default(SCHEDULED)
  homeTeamId    String
  awayTeamId    String
  homeTeam      Team          @relation("home", fields: [homeTeamId], references: [id])
  awayTeam      Team          @relation("away", fields: [awayTeamId], references: [id])
  homeGoals     Int? // FT score mirror for fast queries; Result is the ledger
  awayGoals     Int?
  htHome        Int? // half-time score (first half); second half = FT − HT
  htAway        Int?
  homeXg        Float?
  awayXg        Float?
  homeShots     Int?
  awayShots     Int?
  homeCorners   Int?
  awayCorners   Int?
  statsFetched  Boolean       @default(false) // corners/shots requested from the provider (avoid re-asking)
  homeTackles   Int? // sum of the side's players' tackles (API-Football fixture detail)
  awayTackles   Int?
  detailFetched Boolean       @default(false) // full fixture detail (stats + players) requested: corners, shots AND tackles
  venue         String?
  predictions   Prediction[]
  results       Result[]
  odds          OddsQuote[]
  updatedAt     DateTime      @updatedAt
  createdAt     DateTime      @default(now())

  @@unique([provider, externalId])
  @@index([kickoffUtc])
  @@index([leagueId, kickoffUtc])
  @@index([status, kickoffUtc])
}

model TeamRatingSnapshot {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  asOf         DateTime
  modelVersion String
  inputKind    String // "xg" | "shots" | "goals"
  attack       Float // α
  defence      Float // β (multiplier on opponent scoring; >1 = leaky)
  sampleWeight Float // Σw of matches used (effective sample)
  matches      Int
  createdAt    DateTime @default(now())

  @@index([teamId, asOf])
}

model Prediction {
  id           String    @id @default(cuid())
  fixtureId    String
  fixture      Fixture   @relation(fields: [fixtureId], references: [id])
  modelVersion String    @default("dc-xg-cal-v1")
  revision     Int       @default(1)
  generatedAt  DateTime  @default(now())
  lockedAt     DateTime?
  inputsHash   String

  // Expected goals + DC
  lambdaHome Float
  lambdaAway Float
  rho        Float

  // Raw (matrix) probabilities
  rawHome   Float
  rawDraw   Float
  rawAway   Float
  rawOver15 Float
  rawOver25 Float
  rawOver35 Float
  rawOver45 Float
  rawBtts   Float

  // Calibrated (what the UI shows)
  calHome               Float
  calDraw               Float
  calAway               Float
  calOver15             Float
  calOver25             Float
  calOver35             Float
  calOver45             Float
  // Win by 2+ goals (Asian −1.5), from the same matrix
  rawHomeBy2            Float?
  rawAwayBy2            Float?
  calHomeBy2            Float?
  calH1Under15          Float? // first half Under 1.5 (model; not yet calibrated)
  calH1Under25          Float?
  calH2Under25          Float? // second half Under 2.5
  calHomeOrOver25       Float? // home win OR over 2.5
  calAwayOrOver25       Float?
  h1Share               Float? // share of goals in the first half used
  calAwayBy2            Float?
  // Corners and total shots (separate count models; null when there isn't enough stats history)
  cornersLine           Float?
  expCorners            Float?
  rawCornersOver        Float?
  calCornersOver        Float?
  shotsLine             Float?
  expShots              Float?
  rawShotsOver          Float?
  calShotsOver          Float?
  cornerLines           Json? // [{ l: line, o: P(over) }] — offered corner lines for THIS match
  shotLines             Json? // same for total shots
  tacklesLine           Float?
  expTackles            Float?
  calTacklesOver        Float?
  tackleLines           Json? // same for total tackles
  /// Multiscores, read straight off the matrix (not calibrated). Home-side sets and their away mirrors.
  calMsH10_20_30        Float? // 1-0, 2-0 or 3-0
  calMsA01_02_03        Float? // 0-1, 0-2 or 0-3
  calMsH20_21_30_31     Float? // 2-0, 2-1, 3-0 or 3-1
  calMsA02_12_03_13     Float? // 0-2, 1-2, 0-3 or 1-3
  calMsH21_31_41        Float? // 2-1, 3-1 or 4-1 (Sportybet's standard multiscore)
  calMsA12_13_14        Float? // 1-2, 1-3 or 1-4
  /// P(neither team scores three goals in a row). Display only: settling it needs the order the goals
  /// arrived in, and only the final and half-time scores are stored.
  calNoRun3             Float?
  /// P(at most one half produces two or more goals).
  calNoBothHalvesOver15 Float?
  /// P(the margin is a draw or a single goal).
  calNoWinBy2           Float?
  /// P(both sides score at least two) — "GG2+". Off the matrix as a joint probability, not a product.
  calGg2                Float?
  calHtDraw             Float? // draw at half-time
  // Unders are complements of the calibrated overs: under_x = 1 − over_x (lines 2.5 / 3.5 / 4.5).
  calBtts               Float
  calibrationId         String?

  predHomeGoals Int
  predAwayGoals Int
  topScorelines Json // [{h,a,p}] × 5
  matrix        Json // 11×11 truncated matrix for heatmap (rows = home goals)

  confidence Int // 0..100
  band       ConfidenceBand
  dataFlags  String[]
  rationale  Json // string[4], generated from features
  features   Json // the structured features the rationale was built from

  @@unique([fixtureId, modelVersion, revision])
  @@index([fixtureId, generatedAt])
  @@index([lockedAt])
}

model Result {
  id           String   @id @default(cuid())
  fixtureId    String
  fixture      Fixture  @relation(fields: [fixtureId], references: [id])
  homeGoals    Int
  awayGoals    Int
  settledAt    DateTime @default(now())
  source       Provider
  supersedesId String? // correction chain; never delete
  htHome       Int?
  htAway       Int?

  @@index([fixtureId, settledAt])
}

model CalibrationModel {
  id           String    @id @default(cuid())
  provider     Provider?
  modelVersion String
  market       String // "1x2_home" | "1x2_draw" | "1x2_away" | "ou25" | "ou15" | "ou35" | "ou45" | "btts"
  method       String // "identity" | "bucket" | "isotonic"
  n            Int
  // piecewise-linear map: sorted [x, y] knots
  knots        Json
  fittedAt     DateTime  @default(now())
  active       Boolean   @default(true)

  @@index([modelVersion, market, active])
}

model AccuracyDaily {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  modelVersion   String
  scope          String   @default("all") // "all" | leagueId
  n              Int
  brier1x2       Float
  logloss1x2     Float
  hit1x2         Float
  hitOu25        Float
  hitBtts        Float
  byBand         Json // { HIGH: {n, brier, hit}, MEDIUM: ..., LOW: ... }
  baselineHome   Json // { brier, logloss, hit }
  baselineTable  Json
  baselineMarket Json? // de-vigged closing odds, when an odds feed exists
  createdAt      DateTime @default(now())

  @@unique([date, modelVersion, scope])
}

model Slip {
  id          String    @id @default(cuid())
  ownerKey    String // anonymous device key (no accounts in v1)
  name        String    @default("My slip")
  legs        Json // [{fixtureId, market, label, p, addedAt}]
  bookie      String?
  bookingCode String?
  bookingUrl  String?
  bookingAt   DateTime?
  bookingNote String? // unbookable legs / last error, shown to the user
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerKey])
}

model AppSetting {
  key       String   @id
  value     String // JSON; secrets stored AES-256-GCM encrypted, prefixed "enc:"
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model SyncLog {
  id         String    @id @default(cuid())
  provider   Provider
  job        String // "leagues" | "fixtures" | "results" | "standings" | "rate" | "predict"
  ok         Boolean
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([job, startedAt])
}

/// Bookmaker prices (median / best across bookmakers) per market, appended on every fetch.
model OddsQuote {
  id        String   @id @default(cuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id])
  market    String // MarketKey: home, draw, away, dc_1x, over25, btts_no, home_by2, corners_over, ...
  odds      Float // median decimal odds across bookmakers
  best      Float // best decimal odds
  books     Int // number of bookmakers quoting it
  fetchedAt DateTime @default(now())

  @@index([fixtureId, market, fetchedAt])
}

/// The day's rollover banker, fixed the first time it is built so a booked slip never changes under you.
model DailyBanker {
  id        String   @id @default(cuid())
  provider  Provider
  day       String // yyyy-MM-dd in BANKER_TIMEZONE (default Africa/Lagos)
  target    Float // 1.74, 2.25 …
  minLegs   Int
  legs      Json // [{ fixtureId, market, label, match, league, kickoff, p, odds, real }]
  odds      Float
  p         Float
  real      Boolean // every leg priced by a bookmaker
  createdAt DateTime @default(now())

  @@unique([provider, day, target])
}
