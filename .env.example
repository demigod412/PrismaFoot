DATABASE_URL=postgresql://pitchedge:pitchedge@localhost:5432/pitchedge

FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

API_SPORTS_KEY=
API_SPORTS_BASE_URL=https://v3.football.api-sports.io
# If using RapidAPI instead of direct:
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=v3.football.api-sports.io

SPORTMONKS_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football

# Only used to polish the 4-bullet rationale text. Never for probabilities.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SETTINGS_PIN=
# 32+ random chars; encrypts API keys saved from the Settings page (AES-256-GCM)
SETTINGS_ENCRYPTION_KEY=
# Protects /api/cron/* routes
CRON_SECRET=

# Fallback only: each device picks its own kickoff timezone in Settings -> Display.
DEFAULT_TIMEZONE=Africa/Lagos
PREDICTION_LOCK_MINUTES=15
PRIMARY_PROVIDER=api-football
